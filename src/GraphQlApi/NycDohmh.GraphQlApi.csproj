<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NycDohmh.GraphQlApi</RootNamespace>
    <AssemblyName>NycDohmh.GraphQlApi</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <!-- Supplies the Microsoft Entra ID authentication providers (Active Directory Default / Managed Identity)
         that Microsoft.Data.SqlClient 7.x no longer ships in the core package. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.3" />
  </ItemGroup>

</Project>